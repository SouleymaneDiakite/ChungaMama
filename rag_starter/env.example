# Note: psycopg3 connection string (postgresql+psycopg://), not the
# psycopg2 one ChungaMama's own backend uses — langchain-postgres requires
# psycopg3 specifically.
DATABASE_URL=postgresql+psycopg://chungamama:chungamama@localhost:5433/chungamama

# No API key needed — generation runs on Ollama, locally, for free.
